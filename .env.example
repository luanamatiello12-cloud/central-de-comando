# Copie este arquivo para .env.local e preencha. O .env.local nunca vai para o git.

# Supabase (necessário a partir da Etapa 1) — Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# IA (necessário a partir da Etapa 4) — só no servidor, nunca com prefixo NEXT_PUBLIC_
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-opus-5-5

# Fuso usado para "hoje", prazos e relatórios
NEXT_PUBLIC_APP_TZ=America/Sao_Paulo
